+    "pypdf>=4.0",
+]
+
+[project.optional-dependencies]
+dev = ["pytest>=8.0"]
+
+[project.scripts]
+school-capture = "school_capture.cli:main"
+contact-capture = "school_capture.contact_cli:main"
+
+[tool.setuptools.packages.find]
+where = ["."]
+include = ["school_capture*"]
+
+[tool.pytest.ini_options]
+testpaths = ["tests"]
