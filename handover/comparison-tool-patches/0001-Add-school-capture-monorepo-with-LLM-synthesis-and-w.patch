+++ b/tools/school-capture/school_capture/analysis/lexicons.py
@@ -0,0 +1,170 @@
+"""Theme lexicons for subject-area assessment."""
+
+from __future__ import annotations
+
+from school_capture.models import SubjectArea
+
+AREA_LEXICONS: dict[SubjectArea, dict[str, tuple[str, ...]]] = {
+    SubjectArea.CURRICULUM: {
+        "breadth": (
+            "broad",
+            "balanced",
+            "ambitious",
+            "knowledge-rich",
+            "curriculum",
+            "subjects",
+            "gcse",
+            "a level",
+            "a-level",
+            "options",
+            "humanities",
+            "languages",
+            "stem",
+            "reading",
