{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schoolcompass.uk/schemas/qualitative-capture.schema.json",
  "title": "QualitativeCaptureIndex",
  "description": "Experimental qualitative capture sidecar for School Compass comparison_tool",
  "type": "object",
  "required": ["generatedAt", "engineVersion", "schoolCount", "records"],
  "properties": {
    "generatedAt": { "type": "string", "format": "date" },
    "engineVersion": { "type": "string" },
    "schoolCount": { "type": "integer", "minimum": 0 },
    "stats": { "type": "object" },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/QualitativeCaptureRecord" }
    }
  },
  "$defs": {
    "QualitativeSignal": {
      "type": "object",
      "required": ["text", "sourceUrl", "sourceType", "capturedAt"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string", "format": "uri" },
        "sourceType": {
          "enum": [
            "school-website",
            "school-document",
            "local-news",
            "social-media",
            "other"
          ]
        },
        "capturedAt": { "type": "string", "format": "date" },
        "pageTitle": { "type": "string" },
        "section": { "type": "string" }
      }
    },
    "DocumentInventoryItem": {
      "type": "object",
      "required": ["url", "label", "format", "status"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "label": { "type": "string" },
        "format": { "type": "string" },
        "status": {
          "enum": [
            "discovered",
            "extracted",
            "unsupported_format",
            "failed",
            "extract_failed",
            "empty"
          ]
        },
        "foundOn": { "type": "string", "format": "uri" },
        "pageCount": { "type": "string" },
        "charCount": { "type": "string" },
        "listItems": { "type": "string" }
      }
    },
    "SubjectAreaAssessment": {
      "type": "object",
      "required": ["area", "score", "confidence", "summary", "themes", "signals"],
      "properties": {
        "area": {
          "enum": [
            "curriculum",
            "enrichment",
            "ethos",
            "behaviour",
            "send",
            "community"
          ]
        },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "summary": { "type": "string" },
        "themes": { "type": "array", "items": { "type": "string" } },
        "offerings": { "type": "array", "items": { "type": "string" } },
        "narrativeSummary": { "type": "string" },
        "synthesisMethod": { "enum": ["deterministic", "llm"] },
        "signals": {
          "type": "array",
          "items": { "$ref": "#/$defs/QualitativeSignal" }
        }
      }
    },
    "QualitativeCaptureRecord": {
      "type": "object",
      "required": [
        "urn",
        "name",
        "assessedAt",
        "engineVersion",
        "sourcesScanned",
        "areas"
      ],
      "properties": {
        "urn": { "type": "string" },
        "name": { "type": "string" },
        "assessedAt": { "type": "string", "format": "date" },
        "engineVersion": { "type": "string" },
        "sourcesScanned": { "type": "integer", "minimum": 0 },
        "sourceTypes": {
          "type": "array",
          "items": {
            "enum": [
              "school-website",
              "school-document",
              "local-news",
              "social-media",
              "other"
            ]
          }
        },
        "captureNotes": { "type": "array", "items": { "type": "string" } },
        "documentsDiscovered": { "type": "integer", "minimum": 0 },
        "documentsExtracted": { "type": "integer", "minimum": 0 },
        "documentInventory": {
          "type": "array",
          "items": { "$ref": "#/$defs/DocumentInventoryItem" }
        },
        "areas": {
          "type": "array",
          "items": { "$ref": "#/$defs/SubjectAreaAssessment" }
        }
      }
    }
  }
}
